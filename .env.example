# Copy to `.env` for local use, or set these in Vercel → Settings → Environment Variables.
# With no Supabase vars set, the server falls back to in-memory storage (data
# resets on every restart) — fine for quick UI work, not for real persistence.
# With no admin password vars set, the 3 admins run on the defaults below.
#
# Employees are NOT configured here at all — an admin creates each one from
# the dashboard (Employees → Add employee), choosing their username and
# password right there. There's no fixed count and no per-employee env var.

# --- Supabase (Settings → API in your Supabase project) ---
# SUPABASE_URL is the "Project URL". SUPABASE_SERVICE_ROLE_KEY is the
# *service_role* secret key — NOT the anon/public key. This key bypasses Row
# Level Security, so it must only ever be used server-side, never shipped to
# the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin credentials (3 fixed accounts) ---
# CHANGE THESE before deploying anywhere public. Leaving them unset means the
# app runs on the well-known defaults that are committed to this repo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin#2026

ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD=Admin2#2026

ADMIN3_USERNAME=admin3
ADMIN3_PASSWORD=Admin3#2026
