# Copy to `.env` for local use, or set these in Vercel → Settings → Environment Variables.
# Nothing here is required locally: with no Redis vars the server falls back to
# in-memory storage, and with no password vars it uses the defaults below.

# --- Redis (Vercel injects these automatically when you attach a Redis store) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Credentials ---
# CHANGE THESE before deploying anywhere public. Leaving them unset means the
# app runs on the well-known defaults that are committed to this repo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin#2026

EMP1_PASSWORD=Emp1#2026
EMP2_PASSWORD=Emp2#2026
EMP3_PASSWORD=Emp3#2026
EMP4_PASSWORD=Emp4#2026
EMP5_PASSWORD=Emp5#2026
